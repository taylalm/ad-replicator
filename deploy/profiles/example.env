# Build profile for one client's site: PROFILE=<name> bash deploy/vefaas/build_package.sh reads deploy/profiles/<name>.env.
# Copy this file to deploy/profiles/<name>.env (kept out of git) and fill it in.

# Agent, environment and vault ids written into the package (a file with MA_AGENT_ID / MA_ENV_ID / MA_VAULT_ID lines).
IDS_FILE=.env
# Client files laid over the code (a folder clients/<name>/ mirroring the repo paths, kept out of git); empty = none.
CLIENT=""
# Example projects shipped read-only (job ids in ui/data/jobs, space separated); empty = none.
SHOWCASE_JOBS=""
# Client outro shipped with the site (a file name in skills/video-assembly/assets/outro/); empty = no outro.
OUTRO=""
# 1 = ship the example projects' cost records (ui/server/demo_costs.json).
DEMO_COSTS=0
# 1 = refuse to build when the package mentions a name from deploy/profiles/leak_patterns.txt.
LEAK_CHECK=1
# Package file name in deploy/vefaas/dist/.
ZIP_NAME=ad-replicator.zip

# Web app wording and look (empty = neutral defaults). Accent: "main colour,text on it,soft tint" for light and dark mode.
NEXT_PUBLIC_ACCENT_LIGHT=""
NEXT_PUBLIC_ACCENT_DARK=""
NEXT_PUBLIC_PRODUCT_PLACEHOLDER=""
NEXT_PUBLIC_TITLE_PLACEHOLDER=""
NEXT_PUBLIC_CTA_EXAMPLE=""
NEXT_PUBLIC_LEGACY_THEME_KEY=""
