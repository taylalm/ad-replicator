# Your Managed Agents ids. Copy this file to .env (same folder) and fill in your own values:
#   cp .env.example .env
# tools/ma_client.py and the local web app (ui/start.sh) read these three lines; a variable exported in the
# terminal wins over .env. The ids are not secrets. Never put ARK_API_KEY here: export it in the terminal.
MA_AGENT_ID=agent-...
MA_ENV_ID=env-...
MA_VAULT_ID=vlt-...
# Optional: memory stores with the lessons learned from retakes, mounted read-only on every new session
# (comma separated; create and fill them with tools/lessons_publish.py). Empty = no lessons mounted.
MA_MEMORY_STORE_IDS=
# Optional: the private asset library group for the site's "edit the sample" mode (a sample video with people is
# accepted by Seedance only as an asset). Its access key is NOT written here: set BYTEPLUS_ACCESS_KEY /
# BYTEPLUS_SECRET_KEY on the function (an IAM user with the ModelArk asset permissions), or give the function's role
# those permissions. Empty = samples go to Seedance as plain signed links (product-only samples work).
ASSET_GROUP_ID=
